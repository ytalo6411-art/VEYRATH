{
  "name": "veyrath",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A browser-based fantasy virtual tabletop and exploration RPG.",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.68.0",
    "phaser": "^3.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
